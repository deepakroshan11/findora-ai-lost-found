# Copy to .env — Create React App only exposes variables that start with REACT_APP_.

# URL of the FastAPI backend (local: http://localhost:8000, production: your Render URL)
REACT_APP_API_URL=http://localhost:8000

# Supabase → Project Settings → API (used for sign-in)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
