# Copy to .env and fill in. Never commit the real .env file.

# Supabase → Project Settings → Database → Connection string (IPv4 pooler)
DATABASE_URL=

# Cloudinary → Dashboard / API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo → SMTP & API → API Keys (match-alert emails are sent through Brevo's HTTP API)
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=Findora
# Optional: used as the Reply-To address on match emails
GMAIL_ADDRESS=

# Local development only (Render sets PORT itself)
PORT=8000

# Optional: AI Assistant (any OpenAI-compatible API). Free key: https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
